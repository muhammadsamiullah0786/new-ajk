# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secure string — generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Used by prisma/seed.ts to create the first admin account
ADMIN_EMAIL="admin@ajkinsurance.com"
ADMIN_PASSWORD="ChangeMe123!"

# Email notifications (Resend — https://resend.com/api-keys)
#
# IMPORTANT: EMAIL_FROM must be on a domain you have verified at
# https://resend.com/domains. Sending from `onboarding@resend.dev` (Resend's
# shared testing sender) triggers sandbox restrictions and Resend will only
# deliver to the email address you registered the Resend account with.
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="AJK Insurance <notifications@ajk-insurance.com>"
SUPPORT_EMAIL="support@ajk-insurance.com"

# Public site URL (used in email links)
NEXT_PUBLIC_SITE_URL="https://ajk-insurance.com"
